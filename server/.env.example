NODE_ENV=development

PORT=5000

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ephemeral-chat?retryWrites=true&w=majority

# Cloudflare R2 credentials (S3-compatible)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_bucket_name
# e.g. https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# Secrets for signing participant tokens (use long random strings)
SESSION_TOKEN_SECRET=replace_with_a_long_random_string
PARTICIPANT_TOKEN_SECRET=replace_with_another_long_random_string

# Reconnection grace period in milliseconds (default: 30 seconds)
RECONNECT_GRACE_PERIOD_MS=30000

# File size limits
MAX_IMAGE_SIZE_MB=10
MAX_VIDEO_SIZE_MB=100

# Maximum session duration in hours (ceiling)
MAX_SESSION_DURATION_HOURS=48

# Background cleanup interval in milliseconds
CLEANUP_INTERVAL_MS=60000

# Rate limits
UPLOAD_RATE_LIMIT_PER_MIN=10
MESSAGE_RATE_LIMIT_PER_MIN=30
JOIN_RATE_LIMIT=20
PIN_ATTEMPT_RATE_LIMIT=5

# Signed URL expiry in seconds (for download URLs)
SIGNED_URL_EXPIRY_SECONDS=300
